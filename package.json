{
  "name": "codex-progress-hud",
  "version": "0.1.0",
  "description": "A local, privacy-first progress and ETA overlay for Codex tasks.",
  "type": "module",
  "main": "dist/desktop/main.js",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "mcp": "node dist/mcp/main.js",
    "validate:plugin": "node scripts/validate-plugin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "electron": "^44.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
