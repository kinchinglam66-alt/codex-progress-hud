{
  "name": "codex-progress-hud",
  "version": "0.2.1",
  "description": "A local, privacy-first progress and ETA overlay for Codex tasks.",
  "author": "kinchinglam66-alt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinchinglam66-alt/codex-progress-hud.git"
  },
  "homepage": "https://github.com/kinchinglam66-alt/codex-progress-hud#readme",
  "bugs": {
    "url": "https://github.com/kinchinglam66-alt/codex-progress-hud/issues"
  },
  "type": "module",
  "main": "dist/main.js",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "vitest --passWithNoTests",
    "generate:capabilities": "node scripts/generate-capabilities.mjs",
    "typecheck": "npm run generate:capabilities && tsc --noEmit",
    "build": "npm run generate:capabilities && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "npm run start:hud",
    "start:hud": "npm run build && electron . --hud",
    "start:mcp": "npm run build && node dist/main.js --mcp-stdio",
    "mcp": "node dist/mcp/main.js",
    "smoke": "npm run build && node scripts/smoke-test.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "diagnose:mcp": "vitest --run tests/mcp/stdio-server.test.ts --reporter=verbose",
    "diagnose:mcp:packaged": "node scripts/diagnose-packaged-mcp.mjs",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "build:launcher": "node scripts/build-native-launcher.mjs",
    "build:launcher:release": "node scripts/build-native-launcher.mjs --force",
    "pack:win": "npm run build && electron-builder --win --x64 --dir",
    "dist:win": "npm run build && electron-builder --win --x64",
    "sync:plugin": "npm run build:launcher && node scripts/sync-plugin-package.mjs",
    "check:plugin-sync": "node scripts/sync-plugin-package.mjs --check",
    "package:plugin": "node scripts/package-plugin.mjs",
    "checksums": "node scripts/write-checksums.mjs",
    "release:artifacts": "npm run build:launcher:release && npm run dist:win && node scripts/sync-plugin-package.mjs && npm run package:plugin && npm run checksums",
    "test:package-contract": "node scripts/package-contract-test.mjs",
    "verify:release": "npm test -- --run --maxWorkers=1 --no-file-parallelism && npm run typecheck && npm run build && npm run smoke && npm run build:launcher && npm run check:plugin-sync && npm run validate:plugin && npm run test:package-contract"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "electron": "^44.1.0",
    "electron-builder": "26.15.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
